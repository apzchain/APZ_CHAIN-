"""
مدل داده برای ذخیره‌سازی نتایج تحلیل در SQLite
"""

from sqlalchemy import create_engine, Column, String, Integer, Float, DateTime, Text, JSON
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker
from datetime import datetime

Base = declarative_base()

class AnalysisRecord(Base):
    __tablename__ = 'analyses'
    id = Column(Integer, primary_key=True)
    sha256 = Column(String(64), unique=True, index=True)
    file_name = Column(String(256))
    file_size = Column(Integer)
    risk_score = Column(Integer)
    risk_level = Column(String(20))
    confidence = Column(Integer)
    sandbox_verdict = Column(String(20))
    findings_json = Column(JSON)
    report_json = Column(JSON)
    analyzed_at = Column(DateTime, default=datetime.utcnow)
    source = Column(String(50))  # 'gui', 'cli', 'api'

class ReputationRecord(Base):
    __tablename__ = 'reputations'
    id = Column(Integer, primary_key=True)
    sha256 = Column(String(64), index=True)
    overall_verdict = Column(String(20))
    provider_results = Column(JSON)
    checked_at = Column(DateTime, default=datetime.utcnow)

class IOCRecord(Base):
    __tablename__ = 'iocs'
    id = Column(Integer, primary_key=True)
    sha256 = Column(String(64), index=True)
    kind = Column(String(20))
    value = Column(Text)
    source = Column(String(50))
    severity = Column(String(20))
    detected_at = Column(DateTime, default=datetime.utcnow)

def init_db(db_path='apz.db'):
    engine = create_engine(f'sqlite:///{db_path}')
    Base.metadata.create_all(engine)
    return sessionmaker(bind=engine)
